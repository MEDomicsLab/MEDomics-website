{
  "name": "medomics-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-releases.mjs",
    "build": "next build && node scripts/postexport.mjs",
    "serve": "node scripts/serve.mjs",
    "images": "node scripts/optimize-images.mjs",
    "capture": "node scripts/capture.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:knip": "knip",
    "lint:assets": "node scripts/check/unused-assets.mjs",
    "lint:licenses": "node scripts/check/licenses.mjs",
    "lint:releases": "node scripts/check/releases.mjs",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint:strict && npm run format:check && npm run lint:md && npm run lint:knip && npm run lint:assets && npm run lint:licenses && npm run lint:releases && npm run test:scripts",
    "check:links": "node scripts/check/links.mjs",
    "size": "size-limit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:seo": "playwright test e2e/seo.spec.ts",
    "lhci": "lhci autorun --config=.github/lighthouserc.json",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "check:full": "npm run check && npm run build && npm run check:links && npm run size && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "12.1.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "knip": "6.48.0",
    "license-checker-rseidelsohn": "4.4.2",
    "markdownlint-cli2": "0.22.1",
    "playwright-core": "1.65.1",
    "prettier": "3.8.1",
    "sharp": "0.35.5",
    "size-limit": "12.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "size-limit": [
    {
      "name": "JS (all chunks)",
      "path": "out/_next/static/chunks/**/*.js",
      "limit": "300 KB"
    },
    {
      "name": "CSS",
      "path": "out/_next/static/**/*.css",
      "limit": "15 KB"
    }
  ],
  "license": "MIT"
}
